// Qt Design Studio component library metadata.
//
// The Studio builds its component palette from the *.metainfo files it finds
// in a module's own directory -- which is why CMake copies this one next to
// the generated qmldir. Without it every QGravityUI control can still be
// typed by hand but none of them appear in the library, which is the
// difference between a library and a directory of files.
//
// Two deliberate omissions: no `icon`/`libraryIcon`, so the Studio draws its
// own placeholder instead of a wrong picture, and property defaults only
// where a bare instance would otherwise put an invisible item on the canvas
// (a Button with no text is a 0x28 box). Every property named here is
// declared on the component or inherited from its base type.

MetaInfo {
    // --- Primitives --------------------------------------------
    Type {
        name: "QGravityUI.Controls.GText"
        ItemLibraryEntry {
            name: "Text"
            category: "QGravityUI - Primitives"
